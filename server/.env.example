# Server Configuration
PORT=5001
NODE_ENV=production
CORS_ORIGIN=https://your-frontend.vercel.app

# MongoDB Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ai-testing-system?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=7d

# Google Gemini API
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Logging & Flags
LOG_LEVEL=info
ENABLE_WEBHOOKS=true
ENABLE_ANALYTICS=true
ALLOW_TEST_RUN_COMMANDS=false
